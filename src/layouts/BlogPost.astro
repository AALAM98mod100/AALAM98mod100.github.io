---
import type { MarkdownInstance } from 'astro';
import BaseLayout from './BaseLayout.astro';
import PostList from '../components/PostList.astro';
import type { Frontmatter, TopicType } from '../utils/posts';
import { getPostTopics, getRelatedPosts, getTopicsWithPosts, TOPIC_NAMES } from '../utils/posts';
import { formatDate, toISODateTime } from '../utils/date';

interface Props {
  title: string;
  description?: string;
  pubDate: Date | string;
  updatedDate?: Date | string;
  topics: TopicType[] | TopicType;
  url: string;
  private?: boolean;
  tags?: string[];
  readingTime?: number;
}

const {
  title,
  description,
  pubDate: pubDateRaw,
  updatedDate: updatedDateRaw,
  topics,
  url,
  private: isPrivate,
  tags,
  readingTime
} = Astro.props;

// Format dates using the shared utility function
const formattedPubDate = formatDate(pubDateRaw);
const formattedUpdatedDate = updatedDateRaw ? formatDate(updatedDateRaw) : undefined;

const pubDateISO = toISODateTime(pubDateRaw);
const updatedDateISO = updatedDateRaw ? toISODateTime(updatedDateRaw) : undefined;

const topicList = getPostTopics({ topics });

const allPosts = Object.values(
  import.meta.glob<MarkdownInstance<Frontmatter>>('../pages/posts/*.md', { eager: true })
);

const relatedPosts = getRelatedPosts(allPosts, url, topicList, tags ?? []);

// A topic only gets a page, and so only earns a link, when it has a public post
const linkableTopics = new Set(getTopicsWithPosts(allPosts).map(entry => entry.slug));
---

<BaseLayout title={title} description={description} noindex={isPrivate}>
  <article class="blog-post">
    {isPrivate && (
      <div class="private-notice">
        <p>⚠️ Draft — please do not share this link.</p>
      </div>
    )}

    <header class="blog-header">
      <h1 class="blog-title">{title}</h1>
      <div class="blog-meta">
        <span class="blog-date">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
          <time datetime={pubDateISO || undefined}>{formattedPubDate}</time>
        </span>

        {updatedDateRaw && updatedDateISO && (
          <>
            <span class="blog-meta-separator">&middot;</span>
            <span class="blog-date updated">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>
              Updated: <time datetime={updatedDateISO}>{formattedUpdatedDate}</time>
            </span>
          </>
        )}

        {readingTime && (
          <>
            <span class="blog-meta-separator">&middot;</span>
            <span class="blog-reading-time">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
              {readingTime} min
            </span>
          </>
        )}

      </div>
    </header>

    <div class="blog-content">
      <slot />
    </div>

    {topicList.length > 0 && (
      <div class="posted-in">
        <span class="posted-in-label">Posted in:</span>
        {topicList.map(topic => (
          linkableTopics.has(topic)
            ? <a href={`/topics/${topic}/`}>{TOPIC_NAMES[topic]}</a>
            : <span>{TOPIC_NAMES[topic]}</span>
        ))}
      </div>
    )}

    {relatedPosts.length > 0 && (
      <section class="more-like-this">
        <h2 class="more-like-this-heading">More like this</h2>
        <PostList posts={relatedPosts} variant="compact" />
      </section>
    )}
  </article>
</BaseLayout>
