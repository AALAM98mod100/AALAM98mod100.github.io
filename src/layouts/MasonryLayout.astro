---
import { LightGallery } from 'astro-lightgallery';
import photoMetadata from '../data/photo-metadata.json';

// R2 CDN base URL
const R2_BASE_URL = 'https://cdn.ammaralam.me';

// List of photography images hosted on R2
const imageFilenames = [
    '_DSF0436.jpg',
    '_DSF0449.jpg',
    '_DSF0451.jpg',
    '_DSF0466.jpg',
    '_DSF0686.jpg',
    '_DSF0788 1.jpg',
    '_DSF3075.jpg',
    '_DSF3114.jpg',
    '_DSF3126.jpg',
    '_DSF3143.jpg',
    '_DSF3171.jpg',
    '_DSF3225.jpg',
    '_DSF3381.jpg',
    '_DSF3605.jpg',
    '_DSF3622.jpg',
    '_DSF3645 1.jpg',
    '_DSF3836.jpg',
    '_DSF4509.jpg',
    '_DSF4618.jpg',
    '_DSF4676.jpg',
    '_DSF4963 1.jpg',
    'akbarpura-leaf.jpg',
    'light_beam.jpg'
];

function buildSubHtml(filename: string): string {
    const credit = `<h4>Photo by - <a href='https://ammaralam.me'>Ammar Alam</a></h4>`;
    const meta = (photoMetadata as Record<string, any>)[filename];
    if (!meta) return credit;

    const parts: string[] = [];
    if (meta.camera) parts.push(meta.camera);
    if (meta.lens) parts.push(meta.lens);
    const settings: string[] = [];
    if (meta.focalLength) settings.push(`${meta.focalLength}mm`);
    if (meta.aperture) settings.push(`f/${meta.aperture}`);
    if (meta.shutterSpeed) settings.push(meta.shutterSpeed);
    if (meta.iso) settings.push(`ISO ${meta.iso}`);
    if (settings.length) parts.push(settings.join(' · '));

    if (!parts.length) return credit;
    return `${credit}<p class="lg-exif-info">${parts.join('<span class="lg-exif-sep"> | </span>')}</p>`;
}

function getProjectImages() {
    return imageFilenames.map(filename => {
        const filenameWithoutExt = filename.replace('.jpg', '');
        const meta = (photoMetadata as Record<string, any>)[filename];
        return {
            // Full-resolution R2 URL for lightbox modal
            src: `${R2_BASE_URL}/photography/${filename}`,
            // Optimized thumbnail from R2 CDN
            srcThumb: `${R2_BASE_URL}/photography/thumbs/${filenameWithoutExt}.webp`,
            subHtml: buildSubHtml(filename),
            thumbWidth: meta?.thumbWidth,
            thumbHeight: meta?.thumbHeight,
        };
    });
}

const projectImages = getProjectImages();
---
<LightGallery
  class="masonry-grid"
  options={{
    thumbnail: true,
    download: false,
    fullScreen: true,
    selector: '.masonry-item',
  }}
>
  {projectImages.map(image => (
    <a
      class="masonry-item"
      href={image.src}
      data-sub-html={image.subHtml}
    >
      <img src={image.srcThumb} alt="" loading="lazy" width={image.thumbWidth} height={image.thumbHeight} />
    </a>
  ))}
</LightGallery>