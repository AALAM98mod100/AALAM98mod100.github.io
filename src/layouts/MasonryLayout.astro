---
// Explicit CSS import — replaces what the <LightGallery> component previously provided.
// Must stay here (not in src/styles/index.js) to scope it to photography pages only.
import "lightgallery/css/lightgallery-bundle.css";
---

<div id="gallery-container" class="masonry-grid">
  <p class="gallery-loading">Loading...</p>
</div>

<script>
  import { createLightGallery } from 'astro-lightgallery';

  const R2_BASE_URL = 'https://cdn.ammaralam.me';
  const MANIFEST_URL = `${R2_BASE_URL}/photography/manifest.json`;
  const GALLERY_ID = 'gallery-container';

  function escapeHtml(str: string): string {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function buildSubHtml(image: any): string {
    const credit = `<h4>Photo by - <a href='https://ammaralam.me'>Ammar Alam</a></h4>`;
    const parts: string[] = [];
    if (image.camera) parts.push(escapeHtml(String(image.camera)));
    if (image.lens) parts.push(escapeHtml(String(image.lens)));
    const settings: string[] = [];
    if (image.focalLength) settings.push(`${escapeHtml(String(image.focalLength))}mm`);
    if (image.aperture) settings.push(`f/${escapeHtml(String(image.aperture))}`);
    if (image.shutterSpeed) settings.push(escapeHtml(String(image.shutterSpeed)));
    if (image.iso) settings.push(`ISO ${escapeHtml(String(image.iso))}`);
    if (settings.length) parts.push(settings.join(' \u00b7 '));
    if (!parts.length) return credit;
    return `${credit}<p class="lg-exif-info">${parts.join('<span class="lg-exif-sep"> | </span>')}</p>`;
  }

  async function loadGallery() {
    const container = document.getElementById(GALLERY_ID)!;
    try {
      const response = await fetch(MANIFEST_URL);
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      const manifest = await response.json();

      if (!manifest.images?.length) {
        container.innerHTML = '<p>No photos yet.</p>';
        return;
      }

      container.innerHTML = manifest.images.map((image: any) => {
        const stem = image.filename.replace(/\.[^.]+$/, '');
        const src = `${R2_BASE_URL}/photography/display/${image.filename}`;
        const srcThumb = `${R2_BASE_URL}/photography/thumbs/${stem}.webp`;
        // buildSubHtml escapes EXIF values; also escape the whole string for the attribute.
        const subHtml = buildSubHtml(image).replace(/"/g, '&quot;');
        return `<a class="masonry-item" href="${src}" data-sub-html="${subHtml}">` +
          `<img src="${srcThumb}" alt="" loading="lazy" width="${image.thumbWidth}" height="${image.thumbHeight}" />` +
          `</a>`;
      }).join('');

      await createLightGallery(GALLERY_ID, {
        thumbnail: true,
        download: false,
        fullScreen: true,
        selector: '.masonry-item',
      }, []);
    } catch (error) {
      console.error('Failed to load gallery:', error);
      container.innerHTML = '<p>Failed to load gallery.</p>';
    }
  }

  loadGallery();
</script>
