---
interface Props {
	title?: string;
	description?: string;
	/** Keeps the page out of search results. Used by private posts. */
	noindex?: boolean;
}

const { title, description, noindex } = Astro.props;

// Import all styles
import '../styles/index.js';
---

<!doctype html>
<html lang="en">
	<head>
		<script is:inline>
			(function() {
				var theme = localStorage.getItem('theme') || 'light';
				document.documentElement.setAttribute('data-theme', theme);
			})();
		</script>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, initial-scale=1.0" />
		
		<!-- Enhanced Favicon Support -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		
		<meta name="generator" content={Astro.generator} />
		<title>{title ? `${title} | Ammar Alam` : 'Ammar Alam'}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
    	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    	<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&family=Montserrat:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,100;1,200;1,300;1,400&display=swap" rel="stylesheet">
		<meta name="description" content={description || "Ammar Alam's personal website"} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
	</head>
	<body>
		<slot />
	</body>
</html>
