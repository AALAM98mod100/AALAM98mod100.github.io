---
import type { MarkdownInstance } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import type { Frontmatter } from '../../utils/posts';
import { filterPublicPosts, sortPostsByDate, filterPostsByCategory, Category } from '../../utils/posts';

// Try to get posts, handle empty case
let posts: MarkdownInstance<Frontmatter>[] = [];
try {
  // Get all posts from the central posts directory
  const allPosts = await Astro.glob<Frontmatter>('../posts/*.md');
  // Filter by category, filter private posts, and sort by date
  posts = sortPostsByDate(
    filterPostsByCategory(
      filterPublicPosts(allPosts),
      Category.TECHNOLOGY
    )
  );
} catch (error) {
  console.log("Error loading posts:", error);
}
---

<BaseLayout title="Technology">
  <div class="page-content">
    <h1>Technology</h1>
    <p>My thoughts and experiences with various technologies.</p>
    
    <PostList 
      posts={posts} 
      emptyMessage="No technology posts available yet. Check back soon!" 
    />
  </div>
</BaseLayout>

<style>
  .page-content {
    max-width: 800px;
    margin: 0 auto;
  }
  
  h1 {
    font-size: 2.5rem;
    margin-bottom: 1.5rem;
  }
  
  .posts-list {
    margin-top: 2rem;
    display: grid;
    gap: 2rem;
  }
  
  .post-card {
    border: 1px solid #eaeaea;
    border-radius: 8px;
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  
  .post-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.1);
  }
  
  .post-card a {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
  }
  
  .post-image {
    width: 100%;
    height: 200px;
    object-fit: cover;
  }
  
  .post-details {
    padding: 1.5rem;
  }
  
  .post-details h2 {
    font-size: 1.5rem;
    margin: 0 0 0.5rem;
    color: #333;
  }
  
  .post-date {
    color: #777;
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }
  
  .post-description {
    color: #444;
    font-size: 1rem;
    line-height: 1.5;
  }
  
  @media (max-width: 768px) {
    .post-card a {
      flex-direction: column;
    }
    
    .post-image {
      height: 180px;
    }
  }
  
  .no-posts-message {
    text-align: center;
    padding: 2rem;
    background-color: #f9f9f9;
    border-radius: 8px;
    color: #666;
  }
</style> 