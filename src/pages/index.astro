---
import type { MarkdownInstance } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import type { Frontmatter } from '../utils/posts';
import { filterPublicPosts, sortPostsByDate } from '../utils/posts';

// Get all posts from the central posts directory
let allPosts: MarkdownInstance<Frontmatter>[] = [];
try {
	// We want to get all markdown files from the posts directory
	const posts = Object.values(import.meta.glob<MarkdownInstance<Frontmatter>>('./posts/*.md', { eager: true }));
	// Filter out private posts
	allPosts = filterPublicPosts(posts);
} catch (error) {
	console.log("Error loading posts:", error);
}

// Sort posts by date, most recent first
const sortedPosts = sortPostsByDate(allPosts);

// Get the 3 most recent posts
const recentPosts = sortedPosts; //.slice(0, 3);

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<BaseLayout title="Home">
	<div class="home-content">
			<div > 
			  <div class="page-content">
				<h1>Welcome to My Website</h1>
				<p>This is the personal website of Ammar Alam. Feel free to explore my thoughts on books, technology, life, and photography.</p>
				
				<p>I'm a backend developer with over 3 years of experience building enterprise SaaS products. I specialize in Django, Python, and clean architecture patterns, working with large codebases and teams of 20+ engineers across 6 timezones.</p>
				
				<p>Beyond code, I'm passionate about literature, photography, and exploring the intersection of technology and human creativity. I enjoy diving deep into complex topics, from Dostoevsky's psychological insights to the architectural patterns that shape modern software.</p>
			  </div>
		  
			  <a href="../../public/assets/documents/resume.pdf" target="_blank" rel="noopener noreferrer">Resume (pdf)</a>
			</div>
			<PostList 
				posts={recentPosts} 
				emptyMessage="No posts available yet. Check back soon!" 
			/>
		</div>
	</div>
</BaseLayout>
