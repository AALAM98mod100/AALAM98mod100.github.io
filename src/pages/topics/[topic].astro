---
import type { MarkdownInstance } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import type { Frontmatter, TopicType } from '../../utils/posts';
import {
  TOPIC_NAMES,
  TOPIC_SEO_DESCRIPTIONS,
  filterPublicPosts,
  filterPostsByTopic,
  sortPostsByDate,
  getTopicsWithPosts
} from '../../utils/posts';

export async function getStaticPaths() {
  const allPosts = Object.values(
    import.meta.glob<MarkdownInstance<Frontmatter>>('../posts/*.md', { eager: true })
  );
  const publicPosts = filterPublicPosts(allPosts);

  // A topic gets a page only if it has at least one public post
  return getTopicsWithPosts(allPosts).map(({ slug }) => ({
    params: { topic: slug },
    props: { topic: slug, posts: sortPostsByDate(filterPostsByTopic(publicPosts, slug)) }
  }));
}

interface Props {
  topic: TopicType;
  posts: MarkdownInstance<Frontmatter>[];
}

const { topic, posts } = Astro.props;
const name = TOPIC_NAMES[topic];
---

<BaseLayout title={name} description={TOPIC_SEO_DESCRIPTIONS[topic]}>
  <div class="page-content">
    <h1>{name}</h1>

    <PostList posts={posts} />

    <a class="back-link" href="/">All posts</a>
  </div>
</BaseLayout>
