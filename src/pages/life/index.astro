---
import type { MarkdownInstance } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import type { Frontmatter } from '../../utils/posts';
import { filterPublicPosts, sortPostsByDate, filterPostsByCategory, Category } from '../../utils/posts';

// Try to get posts, handle empty case
let posts: MarkdownInstance<Frontmatter>[] = [];
try {
  // Get all posts from the central posts directory
  const allPosts = Object.values(import.meta.glob<MarkdownInstance<Frontmatter>>('../posts/*.md', { eager: true }));
  // Filter by category, filter private posts, and sort by date
  posts = sortPostsByDate(
    filterPostsByCategory(
      filterPublicPosts(allPosts),
      Category.LIFE
    )
  );
} catch (error) {
  console.log("Error loading posts:", error);
}
---

<BaseLayout title="Life">
  <div class="page-content">
    <h1>Life</h1>
    <p>Personal reflections and thoughts on life.</p>
    
    <PostList 
      posts={posts} 
      emptyMessage="No life posts available yet. Check back soon!" 
    />
  </div>
</BaseLayout>

<style>
  .page-content {
    max-width: 800px;
    margin: 0 auto;
  }
  
  h1 {
    font-size: 2.5rem;
    margin-bottom: 1.5rem;
  }
</style> 