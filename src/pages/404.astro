---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404: Page not found">
  <div class="page-content error-container">
    <h1>404: Page Not Found</h1>
    <p class="lead">Sorry, we've misplaced that URL or it's pointing to something that doesn't exist. <a href="/">Head back home</a> to try finding it again.</p>
  </div>

  <script>
    // Handle missing trailing slashes
    (function() {
      const path = window.location.pathname;
      const hasExtension = path.includes('.');
      
      // If the path doesn't end with a slash and isn't a file
      if (!path.endsWith('/') && !hasExtension) {
        // Redirect to the same path with a trailing slash
        window.location.replace(path + '/' + window.location.search);
      }
    })();
  </script>
</BaseLayout> 