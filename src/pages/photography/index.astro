---
import type { MarkdownInstance } from 'astro';
import PhotographyLayout from '../../layouts/PhotographyLayout.astro';
---

<PhotographyLayout title="Photography" description="My photography portfolio">
    <!-- Hero Image Section
  <div class="photo-hero" style="background-image: url('/images/akbarpura-leaf.jpg')">
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <h1>Photography</h1>
      <p class="hero-subtitle">Capturing moments and emotions through the lens</p>
    </div>
  </div>
  
  <div class="photography-container">
    <p class="photography-intro">
      Welcome to my photography portfolio. Here you'll find a collection of my favorite photographs 
      organized into various projects and galleries.
    </p>
    
    <!-- This will be replaced with your photo grid later -->

</PhotographyLayout>