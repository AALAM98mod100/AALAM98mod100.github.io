---
import { Image } from 'astro:assets';
import PhotographyLayout from '../../layouts/PhotographyLayout.astro';
import { photoGalleries } from '../../data/photos.js';
import { getSamplePhotos, getImageLoadingStrategy } from '../../utils/photoUtils.js';

// Get a sample of photos from each gallery for the main page
const featuredPhotos = getSamplePhotos(photoGalleries, 3);
---

<PhotographyLayout title="Photography Portfolio">
  <div class="photography-title">
  </div>
  
  <div class="masonry-grid">
    {featuredPhotos.map((photo, index) => (
      <div class="masonry-item">
        <a href={`/photography/collections/${photo.galleryId}`}>
          <Image 
            src={photo.src} 
            width={800}
            height={600}
            alt={photo.alt} 
            loading={getImageLoadingStrategy(index, 'main')} 
          />
          <div class="caption">
            <span class="photo-title">{photo.caption}</span>
            <span class="gallery-name">From {photo.galleryTitle}</span>
          </div>
        </a>
      </div>
    ))}
  </div>

  {/* Lightbox for image viewing */}
  <div class="lightbox">
    <div class="lightbox-content">
      <img src="" alt="" class="lightbox-image" />
      <div class="lightbox-caption"></div>
    </div>
    <button class="lightbox-close">&times;</button>
    <div class="lightbox-nav">
      <button class="lightbox-prev">&#10094;</button>
      <button class="lightbox-next">&#10095;</button>
    </div>
  </div>
</PhotographyLayout>

<style>
  .view-collections {
    margin-top: 2rem;
    text-align: center;
  }
  
  
  /* Masonry Grid Layout */
  .masonry-grid {
    column-count: 3;
    column-gap: 1.5rem;
    margin: 3rem 0;
  }
  
  .masonry-item {
    break-inside: avoid;
    margin-bottom: 1.5rem;
  }
  
  .masonry-item a {
    display: block;
    position: relative;
    overflow: hidden;
    background-color: #f0f0f0;
  }
  
  .masonry-item img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.8s ease;
  }
  
  .masonry-item:hover img {
    transform: scale(1.05);
  }
  
  .masonry-item .caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0) 100%);
    color: white;
    padding: 1.5rem;
    transform: translateY(0);
    transition: transform 0.4s ease;
    display: flex;
    flex-direction: column;
  }
  
  .masonry-item .photo-title {
    font-size: 1.1rem;
    font-weight: 500;
    margin-bottom: 0.3rem;
  }
  
  .masonry-item .gallery-name {
    font-size: 0.9rem;
    opacity: 0.8;
  }
  
  /* Responsive adjustments */
  @media (max-width: 1024px) {
    .masonry-grid {
      column-count: 2;
    }
  }
  
  @media (max-width: 640px) {
    .masonry-grid {
      column-count: 1;
    }
  }
</style> 