---
const navItems = [
  { title: 'Resume', path: '/documents/resume.pdf' },
  { title: 'Books', path: '/books/' },
  { title: 'Technology', path: '/technology/' },
  { title: 'Life', path: '/life/' },
  { title: 'Photography', path: '/photography/' },
];
---

<nav>
  <div class="site-title">
    <a href="/">Ammar Alam</a>
  </div>
  
  <div class="nav-links">
    {navItems.map(item => (
      <a
        href={item.path}
        class:list={[
          Astro.url.pathname === item.path && 'active',
          item.title === 'Photography' && 'nav-photography',
        ]}
      >
        {item.title}
      </a>
    ))}
  </div>
</nav>
