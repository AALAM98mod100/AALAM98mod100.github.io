---
const navItems = [
  { title: 'Home', path: '/' },
  { title: 'Books', path: '/books/' },
  { title: 'Technology', path: '/technology/' },
  { title: 'Life', path: '/life/' },
  { title: 'Photography', path: '/photography/' },
];
---

<nav>
  <div class="site-title">
    <a href="/">Ammar Alam</a>
  </div>
  
  <div class="nav-links">
    {navItems.map(item => (
      <a href={item.path} class={Astro.url.pathname === item.path ? 'active' : ''}>
        {item.title}
      </a>
    ))}
  </div>
</nav> 