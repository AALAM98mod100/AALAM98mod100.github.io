---
import type { MarkdownInstance } from 'astro';
import type { Frontmatter, CategoryType } from '../utils/posts';
import { formatDate } from '../utils/date';

interface Props {
  posts: MarkdownInstance<Frontmatter>[];
  emptyMessage?: string;
}

const { 
  posts,
  emptyMessage = "No posts available yet. Check back soon!" 
} = Astro.props;

// Helper function to render categories
function renderCategories(categories: CategoryType[] | CategoryType) {
  const categoryArray = Array.isArray(categories) ? categories : [categories];
  return categoryArray;
}
---

<div class="posts-list">
  {posts.length > 0 ? (
    posts.map((post) => (
      <div class="post-card">
        <a href={post.url}>
          {/* {post.frontmatter.image && (
            <img src={post.frontmatter.image} alt={post.frontmatter.title} class="post-image" />
          )} */}
          <div class="post-details">
            <h2>{post.frontmatter.title}</h2>
            <div class="post-meta">
              <span class="post-date">
                {formatDate(post.frontmatter.pubDate)}
              </span>
              <div class="post-categories">
                {renderCategories(post.frontmatter.categories).map(category => (
                  <span class="post-category">{category}</span>
                ))}
              </div>
            </div>
            {post.frontmatter.description && (
              <p class="post-description">{post.frontmatter.description}</p>
            )}
          </div>
        </a>
      </div>
    ))
  ) : (
    <div class="no-posts-message">
      <p>{emptyMessage}</p>
    </div>
  )}
</div>

<style>
  .posts-list {
    margin-top: 2rem;
    display: grid;
    gap: 2rem;
  }
  
  .no-posts-message {
    text-align: center;
    padding: 2rem;
    background-color: #f9f9f9;
    border-radius: 8px;
    color: #666;
  }
  
  .post-card {
    border: 1px solid #eaeaea;
    border-radius: 8px;
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  
  .post-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.1);
  }
  
  .post-card a {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
  }
  
  .post-image {
    width: 100%;
    height: 200px;
    object-fit: cover;
  }
  
  .post-details {
    padding: 1.5rem;
  }
  
  .post-details h2 {
    font-size: 1.5rem;
    margin: 0 0 0.5rem;
    color: #333;
  }
  
  .post-meta {
    display: flex;
    justify-content: space-between;
    color: #777;
    font-size: 0.9rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }
  
  .post-date {
    margin-right: 1rem;
  }
  
  .post-categories {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  
  .post-category {
    text-transform: capitalize;
    color: #0077cc;
    background-color: rgba(0, 119, 204, 0.1);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }
  
  .post-description {
    color: #444;
    font-size: 1rem;
    line-height: 1.5;
  }
  
  @media (max-width: 768px) {
    .post-card a {
      flex-direction: column;
    }
    
    .post-image {
      height: 180px;
    }
  }
</style> 